#!/bin/sh
# Fires after `git checkout` / `git switch`. See regenerate-if-project-yml-changed.sh.
# Args: previous HEAD, new HEAD, and 1 if this was a branch checkout (0 for a bare file checkout).
previous_head="$1"
new_head="$2"
is_branch_checkout="$3"

if [ "$is_branch_checkout" != "1" ]; then
    exit 0
fi

hook_dir="$(cd "$(dirname "$0")" && pwd)"
"$hook_dir/regenerate-if-project-yml-changed.sh" "$previous_head" "$new_head"
